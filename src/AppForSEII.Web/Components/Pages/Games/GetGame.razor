@page "/games/getgame"
@rendermode InteractiveServer
@using AppForSEII.Web.API
@using Microsoft.AspNetCore.Authorization
@inject IAppForSEIIAPIClient apiservice
@inject GameStateContainer gameState
@inject NavigationManager navigation

<h2>See the details of the game</h2>
<div class="row g-2 align-items-end mb-4 pb-3 border-bottom">
    <div class="col-md-4">
        <label for="sport" class="form-label">ID of the game</label>
        <input type="text" class="form-control" id="sport"
               placeholder="e.g. 1" @bind="gameId"/>
    </div>
    <div class="col-md-auto">
        <button type="button" class="btn btn-warning" id="SearchTeams" @onclick="ObtainGame">
            Get the game
        </button>
    </div>
</div>
@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if(showDetails && game != null)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="gameTable">
            <thead>
                <tr>
                    <th>Game Name</th>
                    <th>Sport</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Place</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@game.Name</td>
                    <td>@game.SportName</td>
                    <td>@game.Date.ToString("dd/MM/yyyy")</td>
                    <td>@game.Date.ToString("HH:mm")</td>
                    <td>@game.Place</td>
                    <td>@game.Description</td>
                </tr>
            </tbody>
        </table>
        <h3>Invited Teams</h3>
        @if (game.Invitations == null || !game.Invitations.Any())
        {
            <div class="alert alert-info" id="NoInvitedTeams">No teams have been invited yet.</div>
        }
        else
        {
            <table class="table table-striped table-hover align-middle" id="teamTable">
                <tr>
                    <th>Name</th>
                    <th>Captain</th>
                    <th>Number of members</th>
                    <th>Minimum Age</th>
                    <th>Maximum Age</th>
                    <th>Sport</th>
                    <th>Request Message</th>
                </tr>
                @foreach(var invitation in game.Invitations)
                {
                    <tr>
                        <td>@invitation.Name</td>
                        <td>@invitation.CaptainName @invitation.CaptainSurname</td>
                        <td>@invitation.MaxMembers</td>
                        <td>@invitation.MinAge</td>
                        <td>@invitation.MaxAge</td>
                        <td>@invitation.SportName</td>
                        <td>@invitation.Message</td>
                    </tr>
                }
            </table>
        }
        
        
    </div>
}


@code {
    [SupplyParameterFromQuery(Name = "GameID")]
    public int? gameIdUrl { get; set; }

    private int gameId;
    private GameDTO? game = new GameDTO(); 
    private bool showDetails = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (gameIdUrl.HasValue)
        {
            gameId = gameIdUrl.Value;
            await ObtainGame();             
        }
    }

    protected async Task ObtainGame()
    {
        errorMessage = null;
        showDetails = false;
        try
        {
            game = await apiservice.GetGameAsync(gameId);
            showDetails = game != null;
        }
        catch (ApiException ex) when (ex.StatusCode == 404)
        {
            game = null;
            errorMessage = $"Game with id {gameId} not found.";
        }
        catch (ApiException)
        {
            game = null;
            errorMessage = "The API returned an error. Please try again.";
        }
        catch (HttpRequestException)
        {
            game = null;
            errorMessage = "The API is not reachable.";
        }
        
    }

}
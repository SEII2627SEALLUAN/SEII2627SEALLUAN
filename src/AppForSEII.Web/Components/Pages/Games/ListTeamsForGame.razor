@page "/games/listteamsforgame"
@rendermode InteractiveServer
@using AppForSEII.Web.API
@using Microsoft.AspNetCore.Authorization
@inject IAppForSEIIAPIClient apiservice
@inject GameStateContainer gameState
@* @attribute [Authorize] *@

@* 2. Markup with C# expressions *@
<h2>Select Teams for creating your game</h2>
<div class="row g-2 align-items-end mb-4 pb-3 border-bottom">
    <div class="col-md-4">
        <label for="sport" class="form-label">Sport</label>
        <input type="text" class="form-control" id="sport"
               placeholder="e.g. Soccer" @bind="selectedSport" />
    </div>
    <div class="col-md-4">
        <label for="captainName" class="form-label">Captain name</label>
        <input type="text" class="form-control" id="captainName"
               placeholder="e.g. Elena" @bind="captainName" />
    </div>
    <div class="col-md-auto">
        <button @onclick="SearchTeams" type="button" class="btn btn-warning" id="SearchTeams">
            Search
        </button>
    </div>
</div>
@if (errorMessage != null)
{
    <div class="alert alert-danger" id="ErrorMessage">@errorMessage</div>
}
@if (!searched)
{
    <div class="alert alert-info">Press Search to find teams.</div>
}
else if (Teams == null || !Teams.Any())
{
  <div class="alert alert-warning">
        There are no teams available for the selected filters. Try a different sport or captain.
    </div>
}
else
{
  <h3>Teams</h3>
  <div class="accordion" id="accordionExample">
    @foreach(var team in Teams)
    {
      var isOpen = openTeam == team.Name;
      <div class="accordion-item">
      <h2 class="accordion-header">
        <button class="accordion-button @(isOpen ? "" : "collapsed")" type="button" @onclick="() => Toggle(team.Name)">
          @team.Name
        </button>
      </h2>
      <div class="accordion-collapse collapse @(isOpen ? "show" : "")">
        <div class="accordion-body">
          <table class="table table-striped table-hover align-middle">
              <thead>
                  <tr>
                  <th scope="col">Captain Name</th>
                  <th scope="col">Captain Surname</th>
                  <th scope="col">Number of members</th>
                  <th scope="col">Minimum Age</th>
                  <th scope="col">Maximum Age</th>
                  <th scope="col">Sport Name</th>

                  </tr>
              </thead>
              <tbody>
                  <tr>
                  <td>@team.CaptainName</td>
                  <td>@team.CaptainSurname</td>
                  <td>@team.MaxMembers</td>
                  <td>@team.MinAge</td>
                  <td>@team.MaxAge</td>
                  <td>@team.SportName</td>
                  <td>
                    <button type="button" class="btn btn-sm btn-outline-warning" id="SelectTeam_@team.Name" @onclick="() => SelectTeam(team)">
                        Select Team
                    </button>
                  </td>
                  </tr>
              </tbody>
              </table>
              
        </div>
      </div>
    </div>
    }
    
  </div>

}
<div class="mt-5">
    <h4>Selected teams (@gameState.Game.Invitations.Count)</h4>

    @if (!gameState.Game.Invitations.Any())
    {
        <div class="alert alert-info" id="NoTeamsSelected">No teams selected yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Team</th>
                        <th>Captain Name</th>
                        <th>Captain Surname</th>
                        <th>Max members</th>
                        <th>Minimum Age</th>
                        <th>Maximum Age</th>
                        <th>Sport</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invitation in gameState.Game.Invitations)
                    {
                        <tr>
                            <td>@invitation.Name</td>
                            <td>@invitation.CaptainName</td>
                            <td>@invitation.CaptainSurname</td>
                            <td>@invitation.MaxMembers</td>
                            <td>@invitation.MinAge</td>
                            <td>@invitation.MaxAge</td>
                            <td>@invitation.SportName</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger" id="RemoveTeam_@invitation.Name" @onclick="() => gameState.RemoveTeamFromGame(invitation)">
                                    Remove
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <button @onclick="SearchTeams" type="button" class="btn btn-warning" id="SearchTeams">
                Confirm
            </button>
        </div>
    }
</div>



@* 3. C# logic *@
@code {
  private ICollection<TeamForGameDTO>? Teams { get; set; } = new List<TeamForGameDTO>();
  private string? openTeam;
  private void Toggle(string name) => openTeam = openTeam == name ? null : name;
  private string selectedSport = "";
  private string captainName = "";
  private string? errorMessage;
  private bool searched = false;

  protected async Task SearchTeams() {
    errorMessage = null;
    try { 
      Teams = await apiservice.GetTeamsForGameAsync(selectedSport, captainName);
    } catch (ApiException ex) {
      Teams = new List<TeamForGameDTO>();
    }
    StateHasChanged();
    searched = true;
  }

  private void SelectTeam(TeamForGameDTO team)
  {
    gameState.AddTeamToGame(team);
  }
}

@page "/teams/listusersforteam"
@rendermode InteractiveServer
@implements IDisposable
@using AppForSEII.Web.API
@using Microsoft.AspNetCore.Authorization
@inject IAppForSEIIAPIClient apiservice
@inject TeamStateContainer teamState
@inject NavigationManager navigation
@* @attribute [Authorize] *@

<h2>Select Users for creating your team</h2>

<div class="row g-2 align-items-end mb-4 pb-3 border-bottom">
    <div class="col-md-4">
        <label for="sport" class="form-label">Sport</label>
        <input type="text" class="form-control" id="sport"
               placeholder="e.g. Soccer" @bind="selectedSport" />
    </div>
    <div class="col-md-4">
        <label for="age" class="form-label">Age</label>
        <input type="number" class="form-control" id="age"
               placeholder="e.g. 25" @bind="selectedAge" />
    </div>
    <div class="col-md-auto">
        <button @onclick="SearchUsers" type="button" class="btn btn-warning" id="SearchUsers">
            Search
        </button>
    </div>
</div>

@if (errorMessage != null)
{
    <div class="alert alert-danger" id="ErrorMessage">@errorMessage</div>
}

@if (!searched)
{
    <div class="alert alert-info">Loading players...</div>
}
else if (Users == null || !Users.Any())
{
    <div class="alert alert-warning" id="NoUsersFound">
        There are no players available for the selected filters. Try a different sport or age.
    </div>
}
else
{
    <h3>Players</h3>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="TableOfUsers">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Surname</th>
                    <th scope="col">Age</th>
                    <th scope="col">Sports &amp; Skill (1-5)</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Users)
                {
                    bool isSelected = teamState.Team.TeamInvitations.Any(ti => ti.UserName == user.UserName);
                    <tr id="UserData_@user.UserName">
                        <td>@user.Name</td>
                        <td>@user.Surname</td>
                        <td>@user.Age</td>
                        <td>@(string.IsNullOrWhiteSpace(user.Skill) ? "-" : user.Skill)</td>
                        <td class="text-end">
                            <button type="button"
                                    class="btn btn-sm @(isSelected ? "btn-warning" : "btn-outline-warning")"
                                    id="SelectUser_@user.UserName"
                                    @onclick="() => SelectUser(user)">
                                @(isSelected ? "Selected" : "Select User")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-5">
    <h4>Selected players (@teamState.Team.TeamInvitations.Count)</h4>

    @if (!teamState.Team.TeamInvitations.Any())
    {
        <div class="alert alert-info" id="NoUsersSelected">No players selected yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle" id="TableOfSelectedUsers">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Surname</th>
                        <th>Age</th>
                        <th>Invitation Message</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invitation in teamState.Team.TeamInvitations)
                    {
                        <tr>
                            <td>@invitation.UserName</td>
                            <td>@invitation.UserSurname</td>
                            <td>@invitation.UserAge</td>
                            <td>@invitation.InvitationMessage</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        id="RemoveUser_@invitation.UserName"
                                        @onclick="() => teamState.RemoveUserFromTeam(invitation)">
                                    Remove
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <button @onclick="NavigateToCreateTeam" type="button" class="btn btn-warning" id="ConfirmSelection">
                Confirm
            </button>
        </div>
    }
</div>

@code {
    private ICollection<ApplicationUserDTO>? Users { get; set; } = new List<ApplicationUserDTO>();
    private string selectedSport = "Soccer";
    private int? selectedAge;
    private string? errorMessage;
    private bool searched = false;

    protected override async Task OnInitializedAsync()
    {
        teamState.OnChange += StateHasChanged;
        await SearchUsers();
    }

    public void Dispose()
    {
        teamState.OnChange -= StateHasChanged;
    }

    protected async Task SearchUsers()
    {
        errorMessage = null;
        try
        {
            string? sportFilter = string.IsNullOrWhiteSpace(selectedSport) ? null : selectedSport;
            Users = await apiservice.GetUsersForTeamAsync(sportFilter, selectedAge);
        }
        catch (ApiException)
        {
            errorMessage = "Error while connecting to the system.";
            Users = new List<ApplicationUserDTO>();
        }
        searched = true;
        StateHasChanged();
    }

    private void SelectUser(ApplicationUserDTO user)
    {
        teamState.AddUserToTeam(user);
    }

    private void NavigateToCreateTeam()
    {
        navigation.NavigateTo("/teams/createteam");
    }
}
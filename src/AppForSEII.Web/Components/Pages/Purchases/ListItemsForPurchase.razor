@* 1. Directives *@
@page "/purchases/listitemsforpurchase"
@using AppForSEII.Web.API
@using AppForSEII.Web.API
@using Microsoft.AspNetCore.Authorization
@inject IAppForSEIIAPIClient apiservice 
@inject PurchaseStateContainer purchaseState
@* @attribute [Authorize]  *@

@* 2. Markup with C# expressions *@ 
<h2>Select items to purchase</h2>
<div class="row g-2 align-items-end mb-4 pb-3 border-bottom">
    <div class="col-md-4">
        <label for="itemName" class="form-label">Item name</label>
        <input type="text" class="form-control" id="itemName"
               placeholder="e.g. Soccer Ball" @bind="selectedItemName" />
    </div>
    <div class="col-md-4">
        <label for="gender" class="form-label">Gender</label>
        <input type="text" class="form-control" id="gender"
               placeholder="Male, Female or Other" @bind="selectedGender" />

    </div>
    <div class="col-md-4">
        <label for="sportName" class="form-label">Sport Name</label>
        <input type="text" class="form-control" id="sportName"
               placeholder="e.g. Elena" @bind="selectedSportName" />

    </div>
    <div class="col-md-auto">
        <button @onclick="BrowseItems" type="button" class="btn btn-warning" id="BrowseItems">
            Search
        </button>
    </div>
</div>
@if (errorMessage != null)
{
    <div class="alert alert-danger" id="ErrorMessage">@errorMessage</div>
}
@if (!searched)
{
    <div class="alert alert-info">Press Search to browse items.</div>
}
else if (Items == null || !Items.Any())
{
  <div class="alert alert-warning">
        There are no items available for the selected filters.
    </div>
}
else
{
  <h3>items</h3>
  <div class="accordion" id="accordionExample">
    @foreach(var item in Items)
    {
      var isOpen = openItem == item.Name;
      <div class="accordion-item">
      <h2 class="accordion-header">
        <button class="accordion-button @(isOpen ? "" : "collapsed")" type="button" @onclick="() => Toggle(item.Name)">
          @item.Name
        </button>
      </h2>
      <div class="accordion-collapse collapse @(isOpen ? "show" : "")">
        <div class="accordion-body">
          <table class="table table-striped table-hover align-middle">
              <thead>
                  <tr>
                  <th scope="col">Item</th>
                  <th scope="col">Recommended age</th>
                  <th scope="col">Gender</th>
                  <th scope="col">Price</th>
                  <th scope="col">Size</th>
                  <th scope="col">Sport</th>

                  </tr>
              </thead>
              <tbody>
                  <tr>
                  <td>@item.Name</td>
                  <td>@item.RecommendedAge</td>
                  <td>@item.Gender</td>
                  <td>@item.Price</td>
                  <td>@item.Size</td>
                  <td>@item.SportName</td>
                  <td>
                    <button type="button" class="btn btn-sm btn-outline-warning" id="SelectItem_@item.Name" @onclick="() => SelectItem(item)">
                        Select item
                    </button>
                  </td>
                  </tr>
              </tbody>
              </table>
              
        </div>
      </div>
    </div>
    }
    
  </div>

}
<div class="mt-5">
    <h4>Selected items (@purchaseState.Purchase.PurchaseItems.Count)</h4>

    @if (!purchaseState.Purchase.PurchaseItems.Any())
    {
        <div class="alert alert-info" id="NoitemsSelected">No items selected yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Recommended age</th>
                        <th>Gender</th>
                        <th>Price</th>
                        <th>Size</th>
                        <th>Sport</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var purchaseItem in purchaseState.Purchase.PurchaseItems)
                    {
                        <tr>
                            <td>@purchaseItem.Name</td>
                            <td>@purchaseItem.RecommendedAge</td>
                            <td>@purchaseItem.Gender</td>
                            <td>@purchaseItem.Price</td>
                            <td>@purchaseItem.Size</td>
                            <td>@purchaseItem.</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger" id="RemoveItem_@purchaseItem.Name" @onclick="() => purchaseState.RemovePurchaseItemToRent(purchaseItem)">
                                    Remove
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <button @onclick="BrowseItems" type="button" class="btn btn-warning" id="BrowseItems">
                Confirm
            </button>
        </div>
    }
</div>


@* 3. C# logic *@
@code { 
    private ICollection<ItemDTO>? Items { get; set; } = new List<ItemDTO>(); 
    private string? openItem;
    private void Toggle(string name) => openItem = openItem == name ? null : name;
    private string selectedItemName = "";
    private string selectedGender = "";
    private string captainName = "";
    private string selectedSportName = "";
    private string? errorMessage;
    private bool searched = false;
    protected async void BrowseItems() {
        try{ 
            Items = await apiservice.GetItemsForPurchaseAsync(null, null,null); 
        } catch (ApiException ex) { 
            Items = new List<ItemDTO>(); 
        } 
        StateHasChanged();
    } 
    private void SelectItem(PurchaseItemDTO item)
    {
        purchaseState.AddItemToPurchase(item);
    }
}
@startuml
class Purchase {
    + Id : int <<get>> <<set>>
    + PurchaseDescription : string? <<get>> <<set>>
    + TotalPrice : double <<get>> <<set>>
    + Street : string <<get>> <<set>>
    + City : string <<get>> <<set>>
    + Province : string <<get>> <<set>>
    + CreditCardNumber : string <<get>> <<set>> = "12345678901234567890"
    + CCV : string <<get>> <<set>> = "123"
    + ExpirationDate : string <<get>> <<set>> = "10/30"
    + Wrapped : bool <<get>> <<set>> = false
    + UserId : string <<get>> <<set>> = ""
}
Purchase --> "PurchaseDate" DateTime
Purchase --> "PurchaseStatus" PurchaseStatus
@enduml

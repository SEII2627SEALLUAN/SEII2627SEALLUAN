@startuml
class Team {
    + Team()
    + Team(id:int, name:string, description:string, maxMembers:int, minAge:int, maxAge:int, sport:Sport?, gameInvitations:IList<GameInvitation>?)
    + Id : int <<get>> <<set>>
    + Name : string <<get>> <<set>> = "Team name"
    + Description : string <<get>> <<set>> = "Team name"
    + MaxMembers : int <<get>> <<set>>
    + MinAge : int <<get>> <<set>> = 3
    + MaxAge : int <<get>> <<set>> = 3
}
Team --> "Sport" Sport
Team --> "GameInvitations<GameInvitation>" "IList`1"
@enduml
